@using CalendarView.Services.Music.Interfaces
@using CalendarView.Shared.Models
@using Enums = CalendarView.Services.Music.Enums
@inject IMusicService MusicService;
@inject IMusicServiceLoginData MusicServiceLoginData
@inject Design Design

<style>
    .now-playing-container {
        background: #181818;
        padding: 14px 18px;
        border-radius: 14px;
        color: white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.35);
        flex: 0 0 auto;
        height: fit-content;
        width: auto;
        min-width: 20%;
        max-width: 50%;
        margin: 20px;
    }

    .np-top {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 5px 5px 0px 5px;
        overflow: hidden;
        flex-shrink: 1;
    }

    .np-cover {
        width: clamp(30px, 5.5vmin, 100px);
        height: clamp(30px, 5.5vmin, 100px);
        border-radius: 6px;
        object-fit: cover;
    }

    .np-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .np-title {
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .np-artists {
        color: #cccccc;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .np-state {

    }

    .np-progress {
        margin: 0px 5px 5px 5px;
    }

    .player-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
    }

    .player-controls i {
        font-size: 1.8rem;
        cursor: pointer;
    }

    .player-controls i:hover {
                color: @Design.AccentColor;
    }
</style>

<div class="now-playing-container">
	<div class="np-top">
		<img class="np-cover" src="@MusicService.CurrentTrack?.Cover?.Url" alt="Cover image" />

		<div class="np-info">
			<div class="np-title font-17">@MusicService.CurrentTrack?.Name</div>

			<div class="np-artists font-12">@string.Join(", ", MusicService.CurrentTrack?.Artists.Select(a => a.Name) ?? [])</div>
		</div>

        <div class="np-state font-@(MusicServiceLoginData.CanControlPlayback ? "14" : "20")">
            @if (MusicServiceLoginData.CanControlPlayback)
            {
	            <div class="player-controls">
		            <div>
			            <i class="fa-solid fa-backward-step" @onclick="async () => await MusicService.Previous()"></i>
		            </div>
		            <div>
			            @switch (MusicService.PlayState)
			            {
				            case Enums.PlayState.Playing:
					            <i class="fa-solid fa-pause" @onclick="async () => await MusicService.Pause()"></i>
					            break;
				            case Enums.PlayState.Paused:
					            <i class="fa-solid fa-play" @onclick="async () => await MusicService.Play()"></i>
					            break;
				            case Enums.PlayState.Unspecified:
				            default:
					            <i class="fa-solid fa-stop"></i>
					            break;
			            }
		            </div>
		            <div>
			            <i class="fa-solid fa-forward-step" @onclick="async () => await MusicService.Next()"></i>
		            </div>
	            </div>
            }
            else
            {
	            @switch (MusicService.PlayState)
	            {
		            case Enums.PlayState.Paused:
			            <i class="fa-solid fa-pause"></i>
			            break;
		            case Enums.PlayState.Playing:
			            <i class="fa-solid fa-play"></i>
			            break;
		            case Enums.PlayState.Unspecified:
		            default:
			            <i class="fa-solid fa-stop"></i>
			            break;
	            }
            }
		</div>
	</div>

	<div class="np-progress">
        <ProgressBar Progress="@(MusicService.CurrentTrack?.ProgressInPercent ?? 0)" ForegroundColor="@Design.AccentColor"></ProgressBar>
	</div>
</div>

@code {
	protected override async Task OnInitializedAsync()
	{
		MusicService.SongChanged += async (_, _) => await InvokeAsync(StateHasChanged);
		MusicService.PlayStateChanged += async (_, _) => await InvokeAsync(StateHasChanged);
		if (!MusicService.IsRunning) await MusicService.StartService();
	}
}