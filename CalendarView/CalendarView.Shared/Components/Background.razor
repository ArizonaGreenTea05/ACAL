@using CalendarView.Services
@using CalendarView.Shared.Models
@using static CalendarView.Shared.Utils.CommonFunctions
@inject PictureService PictureService

<style>
	.background-video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		z-index: 0;
	}
</style>

<div style="@BackgroundImageStyle">
	@if (IsVideo(CurrentPictureUrl))
	{
		<video class="background-video" autoplay muted loop playsinline>
			<source src="@CurrentPictureUrl" />
		</video>
	}

	<div style="margin: 0; padding: 0; z-index: 1; height: 100vh; width: 100%; backdrop-filter: blur(@(DifferentiatedDesign?.CustomBackgroundImageBlur ?? "10px"));">
		@ChildContent
	</div>
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }

	[Parameter] public bool ShowBackgroundImage { get; set; }

	[Parameter] public DifferentiatedDesign? DifferentiatedDesign { get; set; }

	private string CurrentPictureUrl => PictureService.CurrentPictureUrl ?? string.Empty;

	private string? _cachedBackgroundImageStyle;
	private string? _lastPictureUrl;
	private string? _lastOverlay;
	private bool _lastShowBackgroundImage;

	private string BackgroundImageStyle
	{
		get
		{
			var baseStyle = "margin: 0px; padding: 0px; height: 100vh; width: 100%;";

			var currentUrl = CurrentPictureUrl;
			var currentOverlaySource = DifferentiatedDesign?.CustomBackgroundImageOverlay;
			var currentShowBackgroundImage = ShowBackgroundImage;

			// Return cached style if inputs have not changed
			if (_cachedBackgroundImageStyle is not null
				&& string.Equals(_lastPictureUrl, currentUrl, StringComparison.Ordinal)
				&& string.Equals(_lastOverlay, currentOverlaySource, StringComparison.Ordinal)
				&& _lastShowBackgroundImage == currentShowBackgroundImage)
			{
				return _cachedBackgroundImageStyle;
			}

			string result;

			if (!currentShowBackgroundImage || string.IsNullOrWhiteSpace(currentUrl))
			{
				result = baseStyle;
			}
			else if (!currentUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
			{
				// Validate that URL is a data URI (from PictureService) for security
				result = baseStyle;
			}
			else
			{
				var overlay = currentOverlaySource ?? "radial-gradient(circle at center, rgba(0, 0, 0, 0.7) 40%, rgba(0, 0, 0, 0.8) 100%)";
				// Use single quotes in url() to avoid escaping issues with data URIs
				result = $"background-image: {overlay}, url('{currentUrl}'); background-blend-mode: multiply; background-repeat: no-repeat; background-position: center; background-size: cover; {baseStyle}";
			}

			// Update cache
			_cachedBackgroundImageStyle = result;
			_lastPictureUrl = currentUrl;
			_lastOverlay = currentOverlaySource;
			_lastShowBackgroundImage = currentShowBackgroundImage;

			return result;
		}
	}

	protected override Task OnInitializedAsync()
	{
		PictureService.ItemHasChanged += async (_, _) =>
		{
			if (ShowBackgroundImage) await InvokeAsync(StateHasChanged);
		};
		return Task.CompletedTask;
	}


}