@using CalendarView.Services.Text
@inject TextService TextService

<div style="text-align: left; padding: 2px; @(Style ?? string.Empty)">
	<div class="font-22" style="text-align: left; font-weight: 600;">
		@((MarkupString)(TextService.CurrentItem?.Title ?? string.Empty))
	</div>
	<div class="font-17" style="text-align: left; font-weight: 500;">
		@((MarkupString)(TextService.CurrentItem?.Text ?? string.Empty))
	</div>
	<div class="font-12" style="text-align: left;">
		@((MarkupString)(TextService.CurrentItem?.AdditionalInfo ?? string.Empty))
	</div>
</div>

@code {
	[Parameter] public string? Style { get; set; }

	protected override Task OnInitializedAsync()
	{
		TextService.ItemHasChanged += async (_, _) =>
		{
			await InvokeAsync(StateHasChanged);
		};
		return Task.CompletedTask;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// Trigger re-render after first render to display any pre-loaded text
			await InvokeAsync(StateHasChanged);
		}
	}
}
