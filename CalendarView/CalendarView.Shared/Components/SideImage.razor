@using CalendarView.Services
@using CalendarView.Shared.Models
@using static CalendarView.Shared.Utils.CommonFunctions
@inject PictureService PictureService

<style>
	.side-video {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		z-index: 0;
	}

</style>

<div class="@(Class ?? string.Empty)" style="@BackgroundImageStyle">

	@if (IsVideo(CurrentPictureUrl))
	{
		<video class="side-video" autoplay muted loop playsinline>
			<source src="@CurrentPictureUrl" />
		</video>
	}

	<div style="margin: 0; padding: 0; z-index: 1; height: 100%; display: flex; flex-direction: column;">
		@ChildContent
	</div>
</div>


@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }

	[Parameter] public string? Style { get; set; }

	[Parameter] public string? Class { get; set; }

	[Parameter] public bool ShowImage { get; set; }

	[Parameter] public DifferentiatedDesign? DifferentiatedDesign { get; set; }

	private string CurrentPictureUrl => PictureService.CurrentPictureUrl ?? string.Empty;

	private string? _backgroundImageStyle;
	private string _lastPictureUrl = string.Empty;
	private string? _lastOverlay;
	private string _lastStyle = string.Empty;

	private string BackgroundImageStyle
	{
		get
		{
			var currentUrl = CurrentPictureUrl;
			var currentStyle = Style ?? string.Empty;

			string? overlay = null;
			if (!string.IsNullOrWhiteSpace(currentUrl) &&
			    currentUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
			{
				overlay = DifferentiatedDesign?.CustomSideImageOverlay
				          ?? "radial-gradient(circle at center, rgba(0, 0, 0, 0.2) 40%, rgba(0, 0, 0, 0.8) 100%)";
			}

			if (_backgroundImageStyle != null
			    && string.Equals(_lastPictureUrl, currentUrl, StringComparison.Ordinal)
			    && string.Equals(_lastStyle, currentStyle, StringComparison.Ordinal)
			    && string.Equals(_lastOverlay, overlay, StringComparison.Ordinal))
			{
				return _backgroundImageStyle;
			}

			string result;

			if (string.IsNullOrWhiteSpace(currentUrl) || overlay is null)
			{
				result = $"position: relative; overflow: hidden; padding: 0; {currentStyle}";
			}
			else
			{
				// Use single quotes in url() to avoid escaping issues with data URIs
				result =
					$"position: relative; overflow: hidden; background-image: {overlay}, url('{currentUrl}'); background-blend-mode: multiply; background-repeat: no-repeat; background-position: center; background-size: cover; padding: 0; {currentStyle}";
			}

			_backgroundImageStyle = result;
			_lastPictureUrl = currentUrl;
			_lastStyle = currentStyle;
			_lastOverlay = overlay;

			return result;
		}
	}

	protected override Task OnInitializedAsync()
	{
		PictureService.ItemHasChanged += async (_, _) =>
		{
			if (ShowImage) await InvokeAsync(StateHasChanged);
		};
		return Task.CompletedTask;
	}
}
